GARMIN_USERNAME=your_email@example.com
GARMIN_PASSWORD=your_garmin_password
# Optional; defaults to ~/.garminconnect
# GARMINTOKENS=/path/to/private/garmin-token-directory
# Optional, only for Test-nvidia.py
NVIDIA_API_KEY=your_nvidia_api_key

# Vercel multi-user dashboard: add these individually in Vercel settings.
# Do not upload this file or your .env. See docs/vercel-setup.md.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
# SUPABASE_SECRET_KEY=your_server_only_supabase_secret_key
# CREDENTIALS_ENCRYPTION_KEY=your_base64url_encoded_32_byte_key
# Garmin credentials are entered per user in the app, not in Vercel variables.
